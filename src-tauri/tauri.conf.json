{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "轻羽",
  "version": "0.1.0",
  "identifier": "app.miaoyan.editor.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "轻羽 QingYu",
      "width": 1120,
      "height": 780,
      "minWidth": 960,
      "minHeight": 634,
      "disableInputAccessoryView": true,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "trafficLightPosition": { "x": 18, "y": 30 }
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: qingyu-asset: http://qingyu-asset.localhost https://qingyu-asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      { "ext": ["md", "markdown"], "name": "Markdown", "mimeType": "text/markdown", "role": "Editor", "rank": "Alternate" },
      { "ext": ["txt"], "name": "Text", "mimeType": "text/plain", "role": "Editor", "rank": "Alternate" }
    ],
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "android": { "minSdkVersion": 24 },
    "iOS": { "minimumSystemVersion": "15.0" }
  }
}
