FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html login.html tsconfig.json vite.config.ts ./
COPY src ./src
COPY public ./public
COPY tools/palette.ts ./tools/palette.ts
COPY prototypes/web-login/*.css ./prototypes/web-login/
RUN npm run build:web
RUN npm run build:server-sync

FROM rust:1.96-bookworm AS build
WORKDIR /build
COPY rust-toolchain.toml ./
COPY src-tauri/Cargo.toml src-tauri/Cargo.lock src-tauri/build.rs ./src-tauri/
COPY src-tauri/src ./src-tauri/src
COPY src-tauri/plugins ./src-tauri/plugins
COPY src-tauri/vendor/tauri-runtime-wry ./src-tauri/vendor/tauri-runtime-wry
RUN cargo build --locked --release --manifest-path src-tauri/Cargo.toml \
    --no-default-features --features server --bin qingyu-api

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir /data /config && chown 10001:10001 /data /config && chmod 700 /config
COPY --from=build /build/src-tauri/target/release/qingyu-api /usr/local/bin/qingyu-api
COPY --from=web /web/dist /app/web
COPY --from=web /web/dist-sync /app/sync
USER 10001:10001
# Keep defaults on the legacy names so either prefix can override them at runtime.
ENV MIAOYAN_LIBRARY_DIR=/data MIAOYAN_API_ADDR=0.0.0.0:8787
ENV QINGYU_WEB_DIR=/app/web
ENV QINGYU_SYNC_WORKER=/app/sync/server-sync-worker.mjs
# 客户端配置：轻羽账号会话、S3 连接和自动同步设置，和 /data 里的笔记分开保存
ENV QINGYU_CONFIG_DIR=/config
EXPOSE 8787
VOLUME ["/data", "/config"]
ENTRYPOINT ["/usr/local/bin/qingyu-api"]
