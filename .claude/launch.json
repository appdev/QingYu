{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 1420
    },
    {
      "name": "server-library",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd \"$HOME/.qingyu-server\" && QINGYU_WEB_PASSWORD=\"$(cat web-password)\" QINGYU_WEB_SECURE_COOKIE=false QINGYU_WEB_DIR=\"$PWD/web\" QINGYU_LIBRARY_DIR=\"$PWD/notes\" QINGYU_CONFIG_DIR=\"$PWD/config\" QINGYU_SYNC_WORKER=\"$PWD/sync/server-sync-worker.mjs\" PATH=\"/opt/homebrew/opt/node@24/bin:$PATH\" QINGYU_API_ADDR=127.0.0.1:8797 exec bin/qingyu-api"
      ],
      "port": 8797
    },
    {
      "name": "website",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec python3 -m http.server ${PORT:-4321} --bind 127.0.0.1 --directory website"
      ],
      "port": 4321
    },
    {
      "name": "web-glisse-menu",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "1431",
        "--strictPort"
      ],
      "port": 1431
    },
    {
      "name": "web-liquid-menu",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--host",
        "0.0.0.0",
        "--port",
        "1432",
        "--strictPort"
      ],
      "port": 1432
    }
  ]
}
