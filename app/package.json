{
  "name": "QingYu",
  "desktopName": "com.apkdv.qingyu",
  "version": "1.0.0",
  "description": "QingYu · Clear windows, a quiet desk, words softly spoken.",
  "homepage": "https://apkdv.com/",
  "main": "./electron/main.js",
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "lint": "pnpm run typecheck && eslint . --fix --cache",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --import tsx --test",
    "test:markdown-layout": "electron ./scripts/testMarkdownLayout.cjs",
    "test:markdown-appearance": "node ./scripts/testMarkdownAppearance.cjs",
    "test:markdown-live-preview": "node ./scripts/testMarkdownLivePreview.cjs",
    "dev": "webpack --mode development",
    "dev:mac": "node ./scripts/devMac.js",
    "dev:mobile": "webpack --mode development --config webpack.mobile.js",
    "dev:desktop": "webpack --mode development --config webpack.desktop.js",
    "dev:export": "webpack --mode development --config webpack.export.js",
    "build": "pnpm run /build:.*/",
    "build:app": "webpack --mode production",
    "build:mobile": "webpack --mode production --config webpack.mobile.js",
    "build:desktop": "webpack --mode production --config webpack.desktop.js",
    "build:export": "webpack --mode production --config webpack.export.js",
    "gen:code-languages": "node ./scripts/generateCodeLanguages.cjs",
    "gen:types": "tsc -d",
    "start": "cross-env NODE_ENV=development electron ./electron/main.js",
    "install:electron": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ node node_modules/electron/install.js",
    "sign:dev": "node scripts/signDevElectron.js",
    "dist": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --config electron-builder.yml --publish=never",
    "dist-arm64": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --arm64 --config electron-builder-arm64.yml --publish=never",
    "dist-darwin": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --mac --config electron-builder-darwin.yml --publish=never",
    "dist-darwin-arm64": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --arm64 --mac --config electron-builder-darwin-arm64.yml --publish=never",
    "dist-linux": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --linux --config electron-builder-linux.yml --publish=never",
    "dist-linux-arm64": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --arm64 --linux --config electron-builder-linux-arm64.yml --publish=never"
  },
  "keywords": [
    "markdown",
    "note-taking",
    "notebook"
  ],
  "author": {
    "name": "QingYu Project",
    "email": "lengyue@apkdv.com"
  },
  "devDependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.0",
    "@codemirror/state": "6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "6.43.8",
    "@decimalturn/toml-patch": "3.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.24.0",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.7.2",
    "@replit/codemirror-vim": "6.3.0",
    "@types/d3-dispatch": "3.0.6",
    "@types/jsdom": "21.1.7",
    "@types/node": "^18.13.0",
    "@types/turndown": "5.0.6",
    "@types/zxcvbn": "4.4.5",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "blueimp-md5": "^2.19.0",
    "clean-webpack-plugin": "^4.0.0",
    "codemirror": "^6.0.2",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "dayjs": "^1.11.5",
    "electron": "42.6.1",
    "electron-builder": "26.15.7",
    "encoding": "^0.1.13",
    "esbuild-loader": "^3.0.1",
    "eslint": "^9.15.0",
    "file-loader": "^6.2.0",
    "filesize": "^11.0.13",
    "globals": "^15.12.0",
    "html-loader": "^2.1.2",
    "html-webpack-plugin": "^5.5.0",
    "iconv-lite": "^0.6.3",
    "ifdef-loader": "^2.3.2",
    "jsdom": "26.1.0",
    "jsonc-parser": "3.3.1",
    "katex": "0.16.45",
    "lowlight": "3.3.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "11.16.1",
    "micromark-util-decode-string": "2.0.1",
    "mini-css-extract-plugin": "2.9.2",
    "path-browserify": "^1.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "safer-buffer": "^2.1.2",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "sharp": "^0.35.3",
    "tsx": "^4.22.4",
    "turndown": "7.2.4",
    "typescript": "^4.9.5",
    "unified": "11.0.5",
    "webpack": "^5.104.1",
    "webpack-bundle-analyzer": "^4.5.0",
    "webpack-cli": "^4.10.0",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "zxcvbn": "4.4.2"
  }
}
