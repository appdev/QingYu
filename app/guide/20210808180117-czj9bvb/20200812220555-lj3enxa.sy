		{
			"ID": "20260813000020-qcn000k",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000020-qcn000k",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "轻语以本地工作空间为核心。只有在你启用同步、网络资源、发布、MCP、WebDAV、S3 或第三方扩展等功能时，相关数据才可能发送到你选择的服务。日志只有在你主动导出或发送时才由你决定披露。"
				}
			]
		},
		{
			"ID": "20260813000021-qcn000l",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000021-qcn000l",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 不要在反馈材料中发送密码、密钥或不必要的私人内容。"
