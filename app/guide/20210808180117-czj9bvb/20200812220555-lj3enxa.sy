			"Properties": {
				"id": "20260813000007-qcn0007",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "工作空间与备份"
				}
			]
		},
		{
			"ID": "20260813000008-qcn0008",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000008-qcn0008",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "文档、配置和日志主要保存在你选择的本地工作空间中。请避免让同步盘直接同时改写工作空间，并定期制作可验证的独立备份。"
				}
			]
		},
		{
			"ID": "20260813000009-qcn0009",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000009-qcn0009",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 退出应用并确认写入完成后再复制工作空间。"
				}
			]
		},
		{
			"ID": "20260813000010-qcn000a",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000010-qcn000a",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 重要数据至少保留一份不与工作空间同时在线的备份。"
				}
			]
		},
		{
			"ID": "20260813000011-qcn000b",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000011-qcn000b",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "编辑、组织与搜索"
				}
			]
		},
		{
			"ID": "20260813000012-qcn000c",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000012-qcn000c",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "轻语使用块编辑器组织文档。你可以创建文档和层级，使用标签、链接和搜索定位内容。"
				}
			]
		},
		{
			"ID": "20260813000013-qcn000d",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000013-qcn000d",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 先在少量非关键文档上熟悉导入、重命名和移动操作。"
				}
			]
		},
		{
			"ID": "20260813000014-qcn000e",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000014-qcn000e",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 批量操作前先备份。"
				}
			]
		},
		{
			"ID": "20260813000015-qcn000f",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000015-qcn000f",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "导入、导出与兼容"
				}
			]
		},
		{
			"ID": "20260813000016-qcn000g",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000016-qcn000g",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "轻语继续读取 .sy 数据和旧 siyuan:// 块链接，用于已有数据兼容；新生成的产品链接使用 qingyu://。兼容并不代表与上游服务互通。"
				}
			]
		},
		{
			"ID": "20260813000017-qcn000h",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000017-qcn000h",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 导入前保留原始文件。"
				}
			]
		},
		{
			"ID": "20260813000018-qcn000i",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000018-qcn000i",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 导出后抽查文本、附件、公式和嵌入内容。"
				}
			]
		},
		{
			"ID": "20260813000019-qcn000j",
