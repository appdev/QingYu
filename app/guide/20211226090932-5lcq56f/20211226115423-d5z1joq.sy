			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "歡迎使用輕語"
				}
			]
		},
		{
			"ID": "20260813000003-qtw0003",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000003-qtw0003",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "輕語是由 appdev 獨立維護的開源筆記應用程式，基於 SiYuan 修改，但不是 SiYuan 官方發行版，也不受其營運方授權、認可或背書。"
				}
			]
		},
		{
			"ID": "20260813000004-qtw0004",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000004-qtw0004",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 網站：https://apkdv.com/"
				}
			]
		},
		{
			"ID": "20260813000005-qtw0005",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000005-qtw0005",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 原始碼：https://github.com/appdev/QingYu"
				}
			]
		},
		{
			"ID": "20260813000006-qtw0006",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000006-qtw0006",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 聯絡：lengyue@apkdv.com"
				}
			]
		},
		{
			"ID": "20260813000007-qtw0007",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000007-qtw0007",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "工作空間與備份"
				}
			]
		},
		{
			"ID": "20260813000008-qtw0008",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000008-qtw0008",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "文件、設定和日誌主要保存在你選擇的本機工作空間。請避免讓同步硬碟同時直接改寫工作空間，並定期製作可驗證的獨立備份。"
				}
			]
		},
		{
			"ID": "20260813000009-qtw0009",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000009-qtw0009",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 結束應用程式並確認寫入完成後再複製工作空間。"
				}
			]
		},
		{
			"ID": "20260813000010-qtw000a",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000010-qtw000a",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 重要資料至少保留一份不與工作空間同時連線的備份。"
				}
			]
		},
		{
			"ID": "20260813000011-qtw000b",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000011-qtw000b",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "編輯、組織與搜尋"
				}
			]
		},
		{
			"ID": "20260813000012-qtw000c",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000012-qtw000c",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "輕語使用區塊編輯器組織文件。你可以建立文件和層級，使用標籤、連結和搜尋定位內容。"
				}
			]
		},
		{
			"ID": "20260813000013-qtw000d",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000013-qtw000d",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 先在少量非關鍵文件上熟悉匯入、重新命名和移動。"
				}
			]
		},
		{
			"ID": "20260813000014-qtw000e",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000014-qtw000e",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 批次操作前先備份。"
				}
			]
		},
		{
			"ID": "20260813000015-qtw000f",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000015-qtw000f",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "匯入、匯出與相容性"
				}
			]
		},
		{
			"ID": "20260813000016-qtw000g",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000016-qtw000g",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "輕語繼續讀取 .sy 資料和舊 siyuan:// 區塊連結，以相容既有資料；新建立的產品連結使用 qingyu://。相容不代表與上游服務互通。"
				}
			]
		},
		{
			"ID": "20260813000017-qtw000h",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000017-qtw000h",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 匯入前保留原始檔案。"
				}
			]
		},
		{
			"ID": "20260813000018-qtw000i",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000018-qtw000i",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 匯出後抽查文字、附件、公式和嵌入內容。"
				}
			]
		},
		{
			"ID": "20260813000019-qtw000j",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000019-qtw000j",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "隱私、安全與網路"
				}
			]
		},
		{
			"ID": "20260813000020-qtw000k",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000020-qtw000k",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "輕語以本機工作空間為核心。只有在你啟用同步、網路資源、發佈、MCP、WebDAV、S3 或第三方擴充功能時，相關資料才可能傳送到你選擇的服務。日誌只有在你主動匯出或傳送時才由你決定揭露。"
				}
			]
		},
		{
			"ID": "20260813000021-qtw000l",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000021-qtw000l",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 不要在回饋資料中傳送密碼、金鑰或不必要的私人內容。"
				}
			]
		},
		{
			"ID": "20260813000022-qtw000m",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000022-qtw000m",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 使用外部服務前閱讀其隱私政策。"
				}
			]
		},
		{
			"ID": "20260813000023-qtw000n",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000023-qtw000n",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "外掛、佈景主題與第三方服務"
				}
			]
		},
		{
			"ID": "20260813000024-qtw000o",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000024-qtw000o",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "外掛、佈景主題和外部連結由各自作者或服務商負責，可能存取內容、網路或本機能力。安裝前檢查來源、權限和更新紀錄。"
				}
			]
		},
		{
			"ID": "20260813000025-qtw000p",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000025-qtw000p",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 輕語開發者不控制第三方服務。"
				}
			]
		},
		{
			"ID": "20260813000026-qtw000q",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000026-qtw000q",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• 發生異常時可先停用最近安裝的擴充功能。"
				}
			]
		},
		{
			"ID": "20260813000027-qtw000r",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000027-qtw000r",
