		},
		{
			"ID": "20260813000002-qen0002",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000002-qen0002",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Welcome to QingYu"
				}
			]
		},
		{
			"ID": "20260813000003-qen0003",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000003-qen0003",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "QingYu is an independently maintained open-source notes application by appdev. It is modified from SiYuan, but it is not an official SiYuan release and is not affiliated with, authorized, endorsed, or sponsored by its operators."
				}
			]
		},
		{
			"ID": "20260813000004-qen0004",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000004-qen0004",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• Website: https://apkdv.com/"
				}
			]
		},
		{
			"ID": "20260813000005-qen0005",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000005-qen0005",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• Source: https://github.com/appdev/QingYu"
				}
			]
		},
		{
			"ID": "20260813000006-qen0006",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000006-qen0006",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• Contact: lengyue@apkdv.com"
				}
			]
		},
		{
			"ID": "20260813000007-qen0007",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000007-qen0007",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Workspace and backups"
				}
			]
		},
		{
			"ID": "20260813000008-qen0008",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000008-qen0008",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Documents, settings, and logs are primarily kept in the local workspace you select. Do not let a sync-drive client concurrently rewrite the live workspace, and create independent backups you can verify."
				}
			]
		},
		{
			"ID": "20260813000009-qen0009",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000009-qen0009",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• Exit the application and let writes finish before copying a workspace."
				}
			]
		},
		{
			"ID": "20260813000010-qen000a",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000010-qen000a",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• Keep at least one important backup outside the live workspace."
				}
			]
		},
		{
			"ID": "20260813000011-qen000b",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000011-qen000b",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Editing, organization, and search"
				}
			]
		},
		{
			"ID": "20260813000012-qen000c",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000012-qen000c",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "QingYu organizes documents with a block editor. You can create document hierarchies and use tags, links, and search to find content."
				}
			]
		},
		{
			"ID": "20260813000013-qen000d",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000013-qen000d",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• Practice imports, renames, and moves on non-critical documents first."
				}
			]
		},
		{
			"ID": "20260813000014-qen000e",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000014-qen000e",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• Back up before bulk operations."
				}
			]
		},
		{
			"ID": "20260813000015-qen000f",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000015-qen000f",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Import, export, and compatibility"
				}
			]
		},
		{
			"ID": "20260813000016-qen000g",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000016-qen000g",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "QingYu continues to read .sy data and legacy siyuan:// block links for existing-data compatibility. Newly generated product links use qingyu://. Compatibility does not mean that upstream services are provided."
				}
			]
		},
		{
			"ID": "20260813000017-qen000h",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000017-qen000h",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• Retain source files before importing."
				}
			]
		},
		{
			"ID": "20260813000018-qen000i",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000018-qen000i",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• Spot-check text, attachments, math, and embedded content after export."
				}
			]
		},
		{
			"ID": "20260813000019-qen000j",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000019-qen000j",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Privacy, security, and networking"
				}
			]
		},
		{
			"ID": "20260813000020-qen000k",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000020-qen000k",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "QingYu is centered on a local workspace. Data may be sent to services you select when you enable synchronization, network resources, publishing, MCP, WebDAV, S3, or third-party extensions. You decide whether to disclose logs by exporting or sending them."
				}
			]
		},
		{
			"ID": "20260813000021-qen000l",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000021-qen000l",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• Do not send passwords, keys, or unnecessary private content in feedback."
				}
			]
		},
		{
			"ID": "20260813000022-qen000m",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000022-qen000m",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• Read an external service's privacy policy before using it."
				}
			]
		},
		{
			"ID": "20260813000023-qen000n",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000023-qen000n",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Plugins, themes, and third parties"
				}
			]
		},
		{
			"ID": "20260813000024-qen000o",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000024-qen000o",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Plugins, themes, and external links are controlled by their authors or providers and may access content, networking, or local capabilities. Review origin, permissions, and update history before installation."
				}
			]
		},
		{
			"ID": "20260813000025-qen000p",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000025-qen000p",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• The QingYu developer does not control third-party services."
				}
			]
		},
		{
			"ID": "20260813000026-qen000q",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000026-qen000q",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• Disable recently installed extensions first when troubleshooting."
				}
			]
		},
		{
			"ID": "20260813000027-qen000r",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000027-qen000r",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Open-source license and support"
				}
			]
		},
		{
			"ID": "20260813000028-qen000s",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000028-qen000s",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "QingYu is distributed under AGPL-3.0. Copyright in upstream code and rights in third-party components remain with their respective owners. appdev independently builds, distributes, and supports QingYu."
				}
			]
		},
		{
			"ID": "20260813000029-qen000t",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000029-qen000t",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• Modified-version notice: /NOTICE.md"
				}
			]
		},
		{
			"ID": "20260813000030-qen000u",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000030-qen000u",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• License: /LICENSE"
				}
			]
		},
		{
			"ID": "20260813000031-qen000v",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000031-qen000v",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "• Support: lengyue@apkdv.com"
				}
			]
		},
		{
			"ID": "20260813000032-qen000w",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20260813000032-qen000w",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Legal documents"
				}
			]
		},
		{
			"ID": "20260813000033-qen000x",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260813000033-qen000x",
				"updated": "20260813000000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Read QingYu's own Privacy Policy and User Agreement before use. They do not adopt terms for any upstream online service."
				}
			]
		},
		{
			"ID": "20260813000034-qen000y",
